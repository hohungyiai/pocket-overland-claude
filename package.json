{
  "name": "pocket-overland",
  "version": "0.1.0",
  "description": "Calm, scenic overland driving game for mobile web",
  "scripts": {
    "maps": "node tools/osm/import.mjs build east-sg && npm run maps:trial --silent",
    "maps:trial": "node tools/osm/redraw.mjs public/maps/east-sg.json public/maps/trial-ucre.json --box 1150,2550,1050,2450 --steps lanes,corners,pair,join,roads --quiet",
    "dev": "npm run maps && vite --host",
    "build": "npm run maps && tsc && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc",
    "check": "node tools/check/run.cjs",
    "limits": "rolldown tools/limits/measure.ts -o node_modules/.cache/limits.mjs -f esm --silent && node node_modules/.cache/limits.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hohungyiai/pocket-overland-claude.git"
  },
  "bugs": {
    "url": "https://github.com/hohungyiai/pocket-overland-claude/issues"
  },
  "homepage": "https://github.com/hohungyiai/pocket-overland-claude#readme",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "private": true,
  "type": "module"
}
